# Sistema Agêntico n8n WhatsApp+Email
# O assistente visual cria .env automaticamente. Nunca versione o arquivo .env real.

# ---------- PostgreSQL / n8n ----------
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_64_CHARS_OR_MORE
GENERIC_TIMEZONE=America/Sao_Paulo

# ---------- LLM local / Ollama ----------
OLLAMA_MODEL=qwen3:4b
OLLAMA_VALIDATOR_MODEL=qwen3:4b

# ---------- WhatsApp / WAHA ----------
WAHA_API_KEY=CHANGE_ME_32_CHARS_OR_MORE
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WAHA_SESSION=default

# ---------- Human-in-the-loop ----------
APPROVAL_EMAIL=

# ---------- Google OAuth2 (opcional no primeiro passo) ----------
# Se informados no assistente visual, o sistema prepara automaticamente
# as credenciais Gmail e Calendar dentro do n8n. A autorização da conta
# Google continua exigindo consentimento no navegador.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback local a cadastrar no Google Cloud:
# http://localhost:5678/rest/oauth2-credential/callback
