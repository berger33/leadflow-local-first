# LeadFlow Local-First — copie para .env e troque TODOS os segredos antes de usar.

# ---------- Assistente local ----------
ASSISTANT_NAME=LeadFlow
APP_ENV=production
LOG_LEVEL=INFO
OLLAMA_MODEL=qwen3:4b
OLLAMA_VALIDATOR_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
VALIDATOR_MIN_SCORE=0.72
MEMORY_TURNS=8

# Pesquisa web sem chave de API, via DDGS/metabuscadores.
WEB_SEARCH_REGION=br-pt
WEB_SEARCH_SAFESEARCH=moderate
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_TIMEOUT_SECONDS=12

# ---------- WhatsApp / WAHA ----------
# Use uma chave longa e aleatória. O mesmo valor é usado pelo Assistente para chamar a WAHA.
WAHA_API_KEY=CHANGE_ME_32_CHARS_OR_MORE
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WAHA_SESSION=default

# Deixe vazio para responder a qualquer conversa privada.
# Para restringir: 5511999999999@c.us,5511888888888@c.us
WHATSAPP_ALLOWED_CHAT_IDS=
WHATSAPP_REPLY_GROUPS=false
WHATSAPP_MAX_REPLY_CHARS=3800

# ---------- n8n ----------
N8N_ENCRYPTION_KEY=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_SECURE_COOKIE=false

# Usados pelo workflow diário.
GMAIL_REPORT_TO=seu-email@gmail.com
DAILY_NEWS_QUERY=inteligência artificial, tecnologia, software, cibersegurança e inovação
DAILY_NEWS_CRON=0 8 * * *

# Opcional: número que pode receber um resumo no WhatsApp em workflows customizados.
REPORT_WHATSAPP_CHAT_ID=
