# Sistema Agêntico n8n WhatsApp+Email
# O bootstrap cria .env automaticamente. Nunca versione o arquivo .env real.

# ---------- PostgreSQL / n8n ----------
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_64_CHARS_OR_MORE
GENERIC_TIMEZONE=America/Sao_Paulo

# ---------- LLM local / Ollama ----------
OLLAMA_MODEL=qwen3:4b
OLLAMA_VALIDATOR_MODEL=qwen3:4b

# ---------- WhatsApp / WAHA ----------
WAHA_API_KEY=CHANGE_ME_32_CHARS_OR_MORE
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WAHA_SESSION=default

# ---------- Human-in-the-loop ----------
# O bootstrap pergunta este endereço na primeira execução.
# Pode ficar vazio enquanto você testa apenas ferramentas não destrutivas.
APPROVAL_EMAIL=

# Gmail e Google Calendar usam OAuth2 configurado diretamente na interface do n8n.
# Nenhum token Google deve ser salvo neste arquivo ou no GitHub.
