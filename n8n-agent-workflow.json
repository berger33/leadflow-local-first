        "filters": {"q": "={{ $fromAI('query','Filtro de pesquisa Gmail; deixe vazio quando não houver filtro') }}"},
        "options": {},
        "descriptionType": "manual",
        "toolDescription": "ler_email(query, limit): lista/lê mensagens do Gmail sem alterá-las. Use quando o usuário pedir para consultar, localizar ou listar e-mails. query aceita sintaxe de busca do Gmail e limit deve ficar entre 1 e 20."
      },
      "id": "09-tool-read-email",
