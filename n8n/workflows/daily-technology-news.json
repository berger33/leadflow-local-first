{
  "name": "LeadFlow - Relatório diário de tecnologia",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "={{ $env.DAILY_NEWS_CRON || '0 8 * * *' }}"
            }
          ]
        }
      },
      "id": "schedule-daily",
      "name": "Todos os dias",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ASSISTANT_INTERNAL_URL + '/research' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ query: '10 notícias mais quentes de ' + ($env.DAILY_NEWS_QUERY || 'tecnologia e inteligência artificial') + ' nas últimas 24 horas', limit: 10, kind: 'news', timelimit: 'd', language: 'pt-BR' }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "research-api",
      "name": "Pesquisar + analisar + validar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $env.GMAIL_REPORT_TO }}",
        "subject": "={{ 'LeadFlow | 10 notícias de tecnologia | ' + $now.format('dd/MM/yyyy') }}",
        "emailType": "html",
        "message": "={{ $json.report_html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-report",
      "name": "Enviar relatório pelo Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [790, 300]
    }
  ],
  "connections": {
    "Todos os dias": {
      "main": [[{"node": "Pesquisar + analisar + validar", "type": "main", "index": 0}]]
    },
    "Pesquisar + analisar + validar": {
      "main": [[{"node": "Enviar relatório pelo Gmail", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {"executionOrder": "v1"},
  "active": false,
  "versionId": "9fe42154-b1bf-41b8-97ce-b20a58ee25cf",
  "meta": {"templateCredsSetupCompleted": false},
  "tags": []
}
